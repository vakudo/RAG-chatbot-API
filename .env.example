OLLAMA_BASE_URL=http://localhost:11434
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
LLM_MODEL=llama3.2
EMBED_MODEL=nomic-embed-text
PG_CONN=postgresql+psycopg://rag:rag@localhost:5432/rag
# rerank retrieved chunks with a local cross-encoder (flashrank)
RERANK=true
# optional: auto-ingest every supported file dropped into this folder
WATCH_DIR=
# optional: require "Authorization: Bearer <token>" on all API requests
API_TOKEN=
